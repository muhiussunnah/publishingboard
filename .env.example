# ============================================================================
#  Famies Publiceringsbord — environment
#
#  WITHOUT these vars the app runs fully dynamic on a local JSON store
#  (.data/db.json), seeded with demo data. Perfect for localhost.
#
#  WITH these vars set, the app automatically switches to Supabase.
#  1. Create a project at https://supabase.com
#  2. Run supabase/schema.sql (and optionally seed via the app)
#  3. Copy this file to .env.local and fill in the values below
# ============================================================================

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose. Used by server actions to read/write data.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Google Gemini API key for the AI tools (Mini Content Writer).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
